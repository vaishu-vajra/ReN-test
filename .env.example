# Local development environment. Copy to .env and fill in:
#   cp .env.example .env
# .env is gitignored — never commit it. Dev credentials are issued at onboarding.

# ── Required: the app refuses to start without these ─────────────────────────
# DataX backend (companies, documents, results). Every read and write goes here.
DATAX_API_URL=
# Signs the service-to-service JWT this engine presents to DataX.
INTERNAL_JWT_SECRET=
INTERNAL_JWT_AUD=datax-internal
INTERNAL_JWT_ISS=ingestion-engine
# Firebase service-account JSON, on one line. Verifies inbound user tokens.
FIREBASE_CREDS=

# ── Environment ──────────────────────────────────────────────────────────────
# Also the Langfuse label prompts are fetched under: dev | production
ENVIRONMENT=dev

# ── LLM (Google Gemini) ──────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# Optional overrides; defaults live in utils/geminiProcessing.py
# GEMINI_MODEL=
# GEMINI_REQUEST_TIMEOUT_MS=

# ── Prompts (Langfuse) ───────────────────────────────────────────────────────
# Optional locally: without these, prompts fall back to the in-repo copies.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Document storage ─────────────────────────────────────────────────────────
# Google Cloud Storage, authenticated by `gcloud auth application-default login`.
GCS_BUCKET_NAME=
# Legacy AWS storage, still used by some ingestion paths.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=
S3_BUCKET_NAME=

# ── Workers ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Ingestion failure log (MongoDB) ──────────────────────────────────────────
MONGO_URI=
MONGO_DB_NAME=

# ── Citation links in generated analysis ─────────────────────────────────────
# Front end the citation links point at. Defaults to production.
REN_APP_BASE_URL=https://dev.myrenx.ai

# ── Financial extraction pipeline ──
# Gemini model used for extraction (default: gemini-3.8-flash)
FINANCIAL_EXTRACT_MODEL=
# Max output tokens per extraction call (default: 32768)
FINANCIAL_EXTRACT_MAX_OUTPUT_TOKENS=
# Max documents per model call (default: 6)
FINANCIAL_MAX_DOCS_PER_CALL=
# Celery rate limit for financial tasks (default: 6/m)
FINANCIAL_RATE_LIMIT=
# Celery soft time limit in seconds (default: 1800)
FINANCIAL_SOFT_TIME_LIMIT=
# Celery hard time limit in seconds (default: 25000)
FINANCIAL_TIME_LIMIT=
# Gemini media resolution for documents (no default; SDK default when unset)
FINANCIAL_MEDIA_RESOLUTION=
# Langfuse prompt name used for extraction (no default; required)
FINANCIAL_PROMPT_NAME=
# Seconds to debounce rapid triggers (no default)
FINANCIAL_DEBOUNCE_SECONDS=
# Seconds between reconcile sweeps (no default)
FINANCIAL_RECONCILE_INTERVAL_SECONDS=
# JWT secret for trigger requests (secret — supplied by the client)
FINANCIAL_TRIGGER_JWT_SECRET=
# JWT audience for trigger requests (secret — supplied by the client)
FINANCIAL_TRIGGER_JWT_AUD=
# JWT issuer for trigger requests (secret — supplied by the client)
FINANCIAL_TRIGGER_JWT_ISS=
