# Template for k8s/overlays/dev/.env — copy to .env and fill in.
#   cp k8s/overlays/dev/.env.example k8s/overlays/dev/.env
#
# The real .env is gitignored (*.env) and has never been committed. It is
# read by secretGenerator in kustomization.yaml, so 'kubectl kustomize' fails
# without it. Keys only here — values come from the team secret store.
#
# Non-secret settings do NOT belong here: put them in the configMapGenerator
# literals in kustomization.yaml, where they are reviewable in git.

AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
DATAX_API_URL=
ENVIRONMENT=
FIREBASE_CREDS=
GCS_BUCKET_NAME=
GOOGLE_API_KEY=
GOOGLE_CLOUD_LOCATION=
GOOGLE_CLOUD_PROJECT=
INTERNAL_JWT_AUD=
INTERNAL_JWT_ISS=
INTERNAL_JWT_SECRET=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MONGO_DB_NAME=
MONGO_URI=
OPENAI_API_KEY=
REDIS_URL=
S3_BUCKET_NAME=
SECRET_KEY=
USAGE_API_URL=
mongo_db_psw=
mongo_db_user=
